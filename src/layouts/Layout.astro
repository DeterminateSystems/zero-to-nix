---
import Banner from "../components/Banner.astro";
import CookieConsent from "../components/CookieConsent.astro";
import Footer from "../components/Footer.astro";
import Head from "../components/Head.astro";
import Navbar from "../components/Navbar.astro";
import "../assets/css/style.css";
import { site } from "../site";

type Props = {
  title?: string;
  description?: string;
  // Keep the page out of search results
  noindex?: boolean;
};

const { defaultLanguage } = site;

const { title, description, noindex } = Astro.props;
---

<html
  lang="en"
  x-data={`{ quickStart: $persist(true), drawer: false, banner: $persist(true), language: $persist("${defaultLanguage}") }`}
  class="h-screen"
>
  <head>
    <Head {title} {description} {noindex} />
  </head>
  <body
    class="text-dark dark:bg-dark flex min-h-full flex-col bg-white font-sans antialiased dark:text-white"
  >
    <Banner />
    <CookieConsent />

    <main class="flex-1">
      <Navbar />

      <slot />
    </main>

    <Footer />

    <script>
      console.log(
        "Welcome to Zero to Nix ❄️! Brought to you by your friends at Determinate Systems.",
      );
    </script>
  </body>
</html>
